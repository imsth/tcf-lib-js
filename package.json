{
  "name": "tcf",
  "version": "1.2.0",
  "description": "Javascript TCF client/server library.",
  "main": "src/tcf.js",
  "browser": {
    "ws": "./src/browser-ws.js",
    "crypto": false,
    "./src/transports.js": "./src/browser-transports.js"
  },
  "license": "MIT",
  "keywords": [
    "nodejs",
    "tcf",
    "client",
    "browser"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Wind-River/tcf-lib-js.git"
  },
  "dependencies": {
    "atob": "^2.0.3",
    "btoa": "^1.1.2",
    "json-bigint": "^1.0.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "browserify": "^17.0.1",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdoc": "^4.0.5",
    "mocha": "^12.0.3",
    "xunit-file": "^0.0.7"
  },
  "scripts": {
    "build": "node -e \"require('fs').mkdirSync('dist', {recursive: true})\" && browserify src/tcf.js -s tcf -i atob -i btoa -i ./src/server.js -i ./src/channel_server_ws.js -o dist/tcf.js",
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "mocha --exit --reporter spec --full-trace \"test/*.js\"",
    "doc": "jsdoc src/tcf.js src/channel.js src/protocol.js src/client.js src/server.js src/services/interfaces.js -R ./README.md -d ./doc/"
  }
}
